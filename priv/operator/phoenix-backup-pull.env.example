BACKUP_PULL_REMOTE=deploy@example.org
BACKUP_PULL_REMOTE_ROOT=/var/backups/my_app/snapshots
BACKUP_PULL_LOCAL_ROOT=/home/operator/backups/my_app/snapshots
BACKUP_PULL_SSH_KEY=/home/operator/.ssh/my_app
# Set to "sudo -n rsync" when the SSH identity has read-only sudo access but
# the application backup directory is private to its service account.
BACKUP_PULL_REMOTE_RSYNC_PATH=rsync
BACKUP_PULL_KEEP_RECENT=7
BACKUP_PULL_KEEP_DAILY_DAYS=14
BACKUP_PULL_KEEP_WEEKLY_DAYS=56
BACKUP_PULL_MIN_FREE_MB=5120
