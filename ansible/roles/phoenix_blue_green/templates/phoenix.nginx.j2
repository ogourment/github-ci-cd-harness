upstream {{ app_name }}_upstream {
    server {{ app_bind_ip | default('127.0.0.1') }}:{{ app_port | default(app_blue_port | default(4000)) }};
}

server {
    listen 80;
    server_name {{ server_name }}{% for alias in server_aliases | default([]) %} {{ alias }}{% endfor %};

    location / {
        proxy_pass http://{{ app_name }}_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
