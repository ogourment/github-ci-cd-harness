MIX_ENV=prod
PHX_SERVER=true
SECRET_KEY_BASE="{{ secret_key_base }}"
DATABASE_URL="ecto://{{ db_user }}:{{ db_password }}@{{ db_host }}:{{ db_port }}/{{ db_name }}"
PHX_HOST="{{ phx_host }}"
PHX_IP="{{ app_bind_ip }}"
PORT={{ slot_port }}
POOL_SIZE={{ phoenix_pool_size | default(10) }}

# Deploy env + blue/green slot identity. The app should surface the color in
# {{ deploy_health_path }} (JSON key "color") so the deploy health-check can
# confirm it cut over to the right instance.
{{ phoenix_env_indicator_var }}="{{ deploy_env }}"
{{ phoenix_color_env_var }}="{{ slot_color }}"
{% if phoenix_uploads_dir and phoenix_uploads_env_var %}
{{ phoenix_uploads_env_var }}="{{ phoenix_uploads_dir }}"
{% endif %}
{% if phoenix_env_extra %}

# --- app-specific (phoenix_env_extra) ---
{{ phoenix_env_extra }}
{% endif %}
