#!/usr/bin/env bash
set -euo pipefail

APP_NAME="{{ app_name }}"
OTP_APP="{{ otp_app_name }}"
APP_ROOT="{{ app_root }}"
APP_USER="{{ app_user }}"
ENV_FILE="{{ app_env_file | default(app_env_dir | default('/etc/' ~ app_name) ~ '/' ~ app_name ~ '.env') }}"
SERVICE_NAME="{{ app_service_name | default(app_name) }}"
RELEASE_ID="${2:-${1:?release id or archive required}}"
RUN_MIGRATIONS="${3:-${2:-}}"
REMOTE_ENV_PREFIX="{{ remote_env_prefix | default(otp_app_name | upper) }}"
DEPLOY_ENV="{{ deploy_env | default('staging') }}"
NOTIFY_SCRIPT="{{ telegram_notify_script | default('/usr/local/bin/' ~ app_name ~ '_telegram_notify') }}"
DEPLOY_STARTED_EPOCH="$(date -u +%s)"

env_value() {
  local name="$1"
  printf '%s' "${!name:-}"
}

duration_label() {
  local seconds="${1:-}"

  case "${seconds}" in
    ''|*[!0-9]*) echo "unknown"; return ;;
  esac

  printf '%sm %ss' "$((seconds / 60))" "$((seconds % 60))"
}

metadata_value() {
  local suffix="$1"
  local fallback="${2:-}"
  local value

  value="$(env_value "${REMOTE_ENV_PREFIX}_${suffix}")"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
  else
    printf '%s' "${fallback}"
  fi
}

APP_DISPLAY_NAME="$(metadata_value APP_NAME "${APP_NAME}")"
APP_VERSION="$(metadata_value APP_VERSION unknown)"
GIT_SUBJECT="$(metadata_value GIT_SUBJECT unknown)"
GIT_MESSAGES="$(metadata_value GIT_MESSAGES "${GIT_SUBJECT}")"
ACTOR="$(metadata_value DEPLOY_ACTOR "${USER:-unknown}")"
CI_PIPELINE_ID="$(metadata_value CI_PIPELINE_ID unknown)"
CI_JOB_ID="$(metadata_value CI_JOB_ID unknown)"
CI_JOB_WAIT_SECONDS="$(metadata_value CI_JOB_WAIT_SECONDS)"
CI_PIPELINE_CREATED_AT_EPOCH="$(metadata_value CI_PIPELINE_CREATED_AT_EPOCH)"
HOST_DEPLOY_NOTIFY="$(metadata_value HOST_DEPLOY_NOTIFY true)"

notify_telegram() {
  if [[ "${HOST_DEPLOY_NOTIFY}" =~ ^(0|false|FALSE|no|NO)$ ]]; then
    return 0
  fi

  if [[ -x "${NOTIFY_SCRIPT}" ]]; then
    TELEGRAM_SILENT="${2:-true}" "${NOTIFY_SCRIPT}" "$1" || true
  fi
}

deployment_timing_summary() {
  local deploy_seconds total_seconds

  deploy_seconds="$(($(date -u +%s) - DEPLOY_STARTED_EPOCH))"
  total_seconds=""
  if [[ "${CI_PIPELINE_CREATED_AT_EPOCH}" =~ ^[0-9]+$ ]]; then
    total_seconds="$(($(date -u +%s) - CI_PIPELINE_CREATED_AT_EPOCH))"
  fi

  printf 'deploy=%s wait=%s total=%s' \
    "$(duration_label "${deploy_seconds}")" \
    "$(duration_label "${CI_JOB_WAIT_SECONDS}")" \
    "$(duration_label "${total_seconds}")"
}

commit_count() {
  local messages

  messages="${GIT_MESSAGES//\\n/$'\n'}"
  printf '%s\n' "${messages}" | grep -c .
}

deployment_commit_messages() {
  local messages
  local lines_shown=0
  local max_lines=5

  messages="${GIT_MESSAGES//\\n/$'\n'}"
  if [ -z "$messages" ]; then
    return 0
  fi

  printf 'commits:\n'
  while IFS= read -r message; do
    [ -z "$message" ] && continue
    printf '- %s\n' "$message"
    lines_shown=$((lines_shown + 1))
    if [ "$lines_shown" -ge "$max_lines" ]; then
      break
    fi
  done <<< "$messages"
}

deployment_metadata_summary() {
  printf 'actor=%s commits=%s pipeline=%s job=%s %s\n' \
    "${ACTOR:-unknown}" \
    "$(commit_count)" \
    "${CI_PIPELINE_ID:-unknown}" \
    "${CI_JOB_ID:-unknown}" \
    "$(deployment_timing_summary)"
  deployment_commit_messages
}

on_deploy_error() {
  status="$?"
  notify_telegram "❌ <b>[${DEPLOY_ENV}] ${APP_DISPLAY_NAME} deployment failed v${APP_VERSION}</b>
release=${RELEASE_ID:-unknown} status=${status}
$(deployment_metadata_summary)" false
  exit "${status}"
}

trap on_deploy_error ERR

if [[ "${1:-}" == *.tar.gz ]]; then
  ARCHIVE="$1"
  DEST_DIR="${APP_ROOT}/releases/${RELEASE_ID}"
  rm -rf "$DEST_DIR"
  mkdir -p "$DEST_DIR"
  tar -xzf "$ARCHIVE" -C "$DEST_DIR" --strip-components=1
else
  SRC_DIR="{{ deploy_releases_root | default('/home/deploy/releases') }}/${1:?release id required}"
  DEST_DIR="${APP_ROOT}/releases/${1}"
  RELEASE_ID="$1"
  rm -rf "$DEST_DIR"
  mkdir -p "$DEST_DIR"
  rsync -a --delete "$SRC_DIR/" "$DEST_DIR/"
fi

chown -R "$APP_USER:$APP_USER" "$DEST_DIR"
ln -sfn "$DEST_DIR" "${APP_ROOT}/current"

if [[ "$RUN_MIGRATIONS" == "migrate" ]]; then
  sudo -u "$APP_USER" bash -lc "
    set -euo pipefail
    set -a
    source '$ENV_FILE'
    set +a
    cd '$DEST_DIR'
    MIX_ENV=prod bin/$OTP_APP eval '{{ release_migrate_module | default('Elixir.' ~ otp_app_name | replace('_', '') ~ '.Release') }}.migrate'
  "
fi

systemctl restart "${SERVICE_NAME}@blue.service" || systemctl restart "${SERVICE_NAME}.service"

notify_telegram "✅ <b>[${DEPLOY_ENV}] ${APP_DISPLAY_NAME} deployment complete v${APP_VERSION}</b>
$(deployment_metadata_summary)" true
trap - ERR
