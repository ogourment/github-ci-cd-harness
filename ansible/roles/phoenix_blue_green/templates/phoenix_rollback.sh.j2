#!/usr/bin/env bash
#
# Rollback helper for {{ app_name }}.
# Flips the nginx upstream back to the other color and ensures it is running.
# Only works while the other color's symlink still points at a prior release.
# Managed by Ansible at {{ deploy_rollback_script_path }} — do not edit by hand.
#
# Usage:  sudo {{ deploy_rollback_script_path }}
#
set -euo pipefail

STAGE_ROOT="{{ app_root }}"
SERVICE_BASE="{{ app_name }}"
NGINX_UPSTREAM_FILE="{{ nginx_upstream_include }}"
NGINX_UPSTREAM_NAME="{{ nginx_upstream_name }}"
CURRENT_COLOR_FILE="{{ app_current_color_file }}"
OTP_APP="{{ otp_app_name }}"
DEPLOY_USER="{{ deploy_user }}"

PORT_BLUE="{{ app_port_blue }}"
PORT_GREEN="{{ app_port_green }}"

HEALTH_PATH="{{ deploy_health_path }}"
HEALTH_TIMEOUT_SEC={{ deploy_health_timeout_sec }}
STANDBY_UNIT="{{ app_name }}-standby-end"

cancel_standby_timer() {
  systemctl stop "${STANDBY_UNIT}.timer" "${STANDBY_UNIT}.service" 2>/dev/null || true
  systemctl reset-failed "${STANDBY_UNIT}.timer" "${STANDBY_UNIT}.service" 2>/dev/null || true
}

CURRENT_COLOR="$(cat "${CURRENT_COLOR_FILE}" 2>/dev/null || echo blue)"
case "${CURRENT_COLOR}" in
  blue)  TARGET_COLOR="green"; TARGET_PORT="${PORT_GREEN}" ;;
  green) TARGET_COLOR="blue" ; TARGET_PORT="${PORT_BLUE}"  ;;
  *) echo "ERROR: invalid current_color '${CURRENT_COLOR}'" >&2; exit 1 ;;
esac

TARGET_LINK="${STAGE_ROOT}/${TARGET_COLOR}"
TARGET_BIN="${TARGET_LINK}/bin/${OTP_APP}"
TARGET_SERVICE="${SERVICE_BASE}@${TARGET_COLOR}.service"
CURRENT_SERVICE="${SERVICE_BASE}@${CURRENT_COLOR}.service"

if [[ ! -x "${TARGET_BIN}" ]]; then
  echo "ERROR: No prior release on ${TARGET_COLOR} (${TARGET_BIN} missing)." >&2
  echo "       Rollback is only possible while the other color retains a working release." >&2
  exit 1
fi

cancel_standby_timer
echo "==> Rolling back: ${CURRENT_COLOR} → ${TARGET_COLOR} (port ${TARGET_PORT})"
systemctl restart "${TARGET_SERVICE}"

deadline=$(( $(date +%s) + HEALTH_TIMEOUT_SEC ))
while true; do
  if curl -sf -o /dev/null --max-time 2 "http://127.0.0.1:${TARGET_PORT}${HEALTH_PATH}"; then
    break
  fi
  if [[ $(date +%s) -ge ${deadline} ]]; then
    echo "ERROR: ${TARGET_COLOR} failed health check after ${HEALTH_TIMEOUT_SEC}s; rollback aborted." >&2
    exit 1
  fi
  sleep 2
done

tmp="$(mktemp)"
cat > "${tmp}" <<EOF
upstream ${NGINX_UPSTREAM_NAME} {
    server 127.0.0.1:${TARGET_PORT};
}
EOF
mv "${tmp}" "${NGINX_UPSTREAM_FILE}"
nginx -t
nginx -s reload

echo "${TARGET_COLOR}" > "${CURRENT_COLOR_FILE}"
chown "${DEPLOY_USER}:${DEPLOY_USER}" "${CURRENT_COLOR_FILE}"

sleep 5
systemctl stop "${CURRENT_SERVICE}" || true

echo "==> Rollback complete. Active = ${TARGET_COLOR}."
